<?xml version="1.0" encoding="utf-8"?>
<!-- Dimensiones de accesibilidad gerontológica (CLAUDE.md §3.3). -->
<resources>
    <!-- Áreas táctiles: mínimo 60dp, ideal ≥ 64dp -->
    <dimen name="touch_target_min">60dp</dimen>
    <dimen name="touch_target">64dp</dimen>
    <!-- Dashboard: acción primaria (uso diario) y secundaria -->
    <dimen name="primary_action_height">136dp</dimen>
    <dimen name="secondary_action_height">88dp</dimen>
    <dimen name="alarm_button_height">96dp</dimen>
    <dimen name="stepper_button_height">80dp</dimen>
    <dimen name="primary_button_height">88dp</dimen>

    <!-- Espaciado: ≥ 12dp entre objetivos táctiles -->
    <dimen name="spacing_touch">12dp</dimen>
    <dimen name="spacing_medium">16dp</dimen>
    <dimen name="spacing_large">24dp</dimen>
    <dimen name="screen_padding">24dp</dimen>

    <!-- Forma de los botones -->
    <!-- Un radio por jerarquía (docs/DESIGN_DIRECTION.md): no hay un radio único para todo. -->
    <dimen name="corner_radius">16dp</dimen>
    <dimen name="corner_radius_alarm">20dp</dimen>
    <dimen name="corner_radius_primary">28dp</dimen>
    <!-- Píldora: la mitad de stepper_button_height; si el botón crece con la fuente, sigue redondeado. -->
    <dimen name="corner_radius_pill">40dp</dimen>
    <dimen name="stroke_strong">3dp</dimen>
    <dimen name="stroke_selected">5dp</dimen>
    <dimen name="button_padding_horizontal">24dp</dimen>
    <dimen name="button_padding_vertical">16dp</dimen>
    <dimen name="icon_size">32dp</dimen>
    <dimen name="icon_feedback_size">48dp</dimen>
    <dimen name="icon_padding">12dp</dimen>
    <!-- Plato circular del icono de las acciones primarias (el icono va dentro, a 36dp) -->
    <dimen name="icon_plate_size">64dp</dimen>
    <dimen name="greeting_icon_size">48dp</dimen>
    <!-- Plato del signo vital junto al título de su pantalla de captura -->
    <dimen name="title_icon_size">48dp</dimen>
    <dimen name="alarm_pictogram_size">160dp</dimen>
    <dimen name="permission_pictogram_size">96dp</dimen>

    <!-- Tipografía (siempre sp): cuerpo 18–20sp, títulos ≥ 24sp, valores ≥ 48sp -->
    <dimen name="text_body">20sp</dimen>
    <dimen name="text_button">22sp</dimen>
    <dimen name="text_action">26sp</dimen>
    <dimen name="text_label">24sp</dimen>
    <dimen name="text_title">28sp</dimen>
    <dimen name="text_greeting">32sp</dimen>
    <dimen name="text_value">60sp</dimen>
    <dimen name="text_alarm_name">34sp</dimen>
</resources>
