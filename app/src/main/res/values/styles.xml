a<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Tipografía ===== -->

    <style name="TextAppearance.VitalLog.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VitalLog.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VitalLog.Value" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">@dimen/text_value</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ===== Botones ===== -->

    <!-- Botón base: fondo claro sólido, borde oscuro, texto oscuro, ≥ 64dp. -->
    <style name="Widget.VitalLog.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/surface_neutral</item>
        <item name="strokeColor">@color/outline_strong</item>
        <item name="strokeWidth">@dimen/stroke_strong</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconPadding">@dimen/icon_padding</item>
    </style>

    <!-- Botón "Volver": icono de flecha + texto, alineado al inicio. -->
    <style name="Widget.VitalLog.Button.Back">
        <item name="icon">@drawable/ic_arrow_back</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Acción masiva del dashboard: icono grande arriba, texto grande abajo. -->
    <style name="Widget.VitalLog.Button.Action">
        <item name="android:minHeight">@dimen/action_button_height</item>
        <item name="android:textSize">@dimen/text_action</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">@dimen/icon_action_size</item>
    </style>

    <style name="Widget.VitalLog.Button.Action.Glucose">
        <item name="backgroundTint">@color/action_glucose_bg</item>
        <item name="strokeColor">@color/action_glucose_fg</item>
        <item name="iconTint">@color/action_glucose_fg</item>
        <item name="icon">@drawable/ic_glucose_drop</item>
    </style>

    <style name="Widget.VitalLog.Button.Action.Pressure">
        <item name="backgroundTint">@color/action_pressure_bg</item>
        <item name="strokeColor">@color/action_pressure_fg</item>
        <item name="iconTint">@color/action_pressure_fg</item>
        <item name="icon">@drawable/ic_pressure_heart</item>
    </style>

    <style name="Widget.VitalLog.Button.Action.Agenda">
        <item name="backgroundTint">@color/action_agenda_bg</item>
        <item name="strokeColor">@color/action_agenda_fg</item>
        <item name="iconTint">@color/action_agenda_fg</item>
        <item name="icon">@drawable/ic_medication</item>
    </style>
</resources>
