<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Tipografía ===== -->
    <!-- Solo dos pesos además del normal, pedidos con textStyle=bold + textFontWeight (API 28+):
         · 700 (negrita): títulos, etiquetas, botones y errores. No se usa sans-serif-medium porque en
           el dispositivo del usuario (fuente del fabricante) se ve igual que el peso normal (Hito 9).
         · 900: solo en ≥ 32sp (saludo, número del stepper, nombre de la alarma). No se usa
           sans-serif-black por la misma razón (Hito 8). En API 26–27 queda la negrita de textStyle.
         textFontWeight elige el peso más cercano que exista en la fuente instalada.
         Cada estilo fija también fontFamily (atributo de AppCompat) y letterSpacing = 0: los padres de
         Material 3 traen fontFamily="sans-serif", que en AppCompat manda sobre android:fontFamily
         (por eso sans-serif-medium nunca se aplicaba), y BodyLarge trae letterSpacing 0.03125. -->

    <style name="TextAppearance.VitalLog.Greeting" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_greeting</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="p">900</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VitalLog.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="p">700</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VitalLog.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VitalLog.Label" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="p">700</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Número del control: peso 900 (text_value ≥ 32sp). -->
    <style name="TextAppearance.VitalLog.Value" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">@dimen/text_value</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="p">900</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Nombre del medicamento o del médico en el modal de alarma: lo primero que hay que leer.
         Peso 900 (text_alarm_name ≥ 32sp). -->
    <style name="TextAppearance.VitalLog.AlarmName" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_alarm_name</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="p">900</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Mensaje de error junto a un campo: rojo oscuro en negrita sobre el fondo de la pantalla. -->
    <style name="TextAppearance.VitalLog.Error" parent="TextAppearance.VitalLog.Body">
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="p">700</item>
        <item name="android:textColor">@color/status_danger</item>
    </style>

    <!-- ===== Botones ===== -->
    <!-- Jerarquía (docs/DESIGN_DIRECTION.md), un radio por nivel:
         Primary (28, 136dp) · Alarm (20, 96dp) · Large: Save / General (16, 88dp) ·
         base: Volver, Borrar, opciones (16, 64dp) · Stepper (píldora, 80dp). -->

    <!-- Botón base: arena sólida, borde tinta, texto tinta en negrita, ≥ 64dp. -->
    <style name="Widget.VitalLog.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="p">700</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/surface_sand</item>
        <item name="strokeColor">@color/outline_strong</item>
        <item name="strokeWidth">@dimen/stroke_strong</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconPadding">@dimen/icon_padding</item>
    </style>

    <!-- Botón "Volver": icono de flecha + texto, alineado al inicio. -->
    <style name="Widget.VitalLog.Button.Back">
        <item name="icon">@drawable/ic_arrow_back</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Botón grande de una pantalla (≥ 88dp, 26sp, icono junto al texto). Base de Save y General. -->
    <style name="Widget.VitalLog.Button.Large">
        <item name="android:minHeight">@dimen/primary_button_height</item>
        <item name="android:textSize">@dimen/text_action</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Botón principal "Guardar …": verde claro sólido, borde y check verde oscuro.
         Excepción documentada: el verde de estado se usa para confirmar un guardado. -->
    <style name="Widget.VitalLog.Button.Save" parent="Widget.VitalLog.Button.Large">
        <item name="backgroundTint">@color/surface_success</item>
        <item name="strokeColor">@color/status_ok</item>
        <item name="iconTint">@color/status_ok</item>
        <item name="icon">@drawable/ic_check</item>
    </style>

    <!-- Acción general: arena sólida con borde e icono cacao. Base de Agregar, Abrir ajustes,
         "No, conservar" y de las acciones secundarias del inicio. -->
    <style name="Widget.VitalLog.Button.General" parent="Widget.VitalLog.Button.Large">
        <item name="backgroundTint">@color/surface_sand</item>
        <item name="strokeColor">@color/brand_primary</item>
        <item name="iconTint">@color/brand_primary</item>
    </style>

    <!-- "Agregar medicamento" / "Agregar cita" (el de cita cambia el icono en el layout). -->
    <style name="Widget.VitalLog.Button.Add" parent="Widget.VitalLog.Button.General">
        <item name="icon">@drawable/ic_add</item>
    </style>

    <!-- "Abrir ajustes" (guía de permisos). -->
    <style name="Widget.VitalLog.Button.OpenSettings" parent="Widget.VitalLog.Button.General">
        <item name="icon">@drawable/ic_settings</item>
    </style>

    <!-- "No, conservar" del diálogo de borrado: la opción segura es la más visible (arena rellena,
         26sp); "Sí, borrar" queda en blanco cálido con borde rojo y 22sp. -->
    <style name="Widget.VitalLog.Button.Keep" parent="Widget.VitalLog.Button.General" />

    <!-- Acción primaria del dashboard (uso diario): "piedra" de radio 28dp y ≥ 136dp; plato
         circular a la izquierda y texto alineado al inicio. El plato trae sus propios colores
         (iconTint @null). Rellenos de 16dp para dejar al texto todo el ancho posible a 2.0×. -->
    <style name="Widget.VitalLog.Button.Primary">
        <item name="android:minHeight">@dimen/primary_action_height</item>
        <item name="android:textSize">@dimen/text_action</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:paddingStart">@dimen/spacing_medium</item>
        <item name="android:paddingEnd">@dimen/spacing_medium</item>
        <item name="iconGravity">start</item>
        <item name="iconSize">@dimen/icon_plate_size</item>
        <item name="iconPadding">@dimen/spacing_medium</item>
        <item name="iconTint">@null</item>
        <item name="cornerRadius">@dimen/corner_radius_primary</item>
    </style>

    <style name="Widget.VitalLog.Button.Primary.Glucose">
        <item name="backgroundTint">@color/vital_glucose_container</item>
        <item name="strokeColor">@color/vital_glucose</item>
        <item name="icon">@drawable/ic_plate_glucose</item>
    </style>

    <style name="Widget.VitalLog.Button.Primary.Pressure">
        <item name="backgroundTint">@color/vital_pressure_container</item>
        <item name="strokeColor">@color/vital_pressure</item>
        <item name="icon">@drawable/ic_plate_pressure</item>
    </style>

    <!-- Acción secundaria del dashboard: una acción general alineada al inicio, con rellenos de
         16dp como las primarias. Texto en tinta completa (nunca gris): menos prominente no
         significa deshabilitada. -->
    <style name="Widget.VitalLog.Button.Secondary" parent="Widget.VitalLog.Button.General">
        <item name="android:minHeight">@dimen/secondary_action_height</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:paddingStart">@dimen/spacing_medium</item>
        <item name="android:paddingEnd">@dimen/spacing_medium</item>
        <item name="iconGravity">start</item>
    </style>

    <style name="Widget.VitalLog.Button.Secondary.Agenda">
        <item name="icon">@drawable/ic_medication</item>
    </style>

    <style name="Widget.VitalLog.Button.Secondary.History">
        <item name="icon">@drawable/ic_history</item>
    </style>

    <!-- Botones Subir / Bajar del control numérico: píldora a todo lo ancho, ≥ 80dp, signo + texto.
         NumericStepperView pinta el acento de la pantalla (app:stepperAccent; aquí, el neutro).
         En el límite cambia a background + outline_strong, quita el signo y muestra
         "Máximo"/"Mínimo" (colores sólidos, nunca opacidad reducida). -->
    <style name="Widget.VitalLog.Button.Stepper">
        <item name="android:minHeight">@dimen/stepper_button_height</item>
        <item name="android:textSize">@dimen/text_action</item>
        <item name="cornerRadius">@dimen/corner_radius_pill</item>
        <item name="backgroundTint">@color/surface_sand</item>
        <item name="strokeColor">@color/brand_primary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">@dimen/icon_size</item>
    </style>

    <!-- Botones del modal de alarma: a todo lo ancho, ≥ 96dp, radio 20, icono + texto grande. -->
    <style name="Widget.VitalLog.Button.Alarm">
        <item name="android:minHeight">@dimen/alarm_button_height</item>
        <item name="android:textSize">@dimen/text_action</item>
        <item name="cornerRadius">@dimen/corner_radius_alarm</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- "Ya lo tomé" / "Entendido": verde claro sólido, borde y check verde oscuro (como Guardar). -->
    <style name="Widget.VitalLog.Button.Alarm.Confirm">
        <item name="backgroundTint">@color/surface_success</item>
        <item name="strokeColor">@color/status_ok</item>
        <item name="iconTint">@color/status_ok</item>
        <item name="icon">@drawable/ic_check</item>
    </style>

    <!-- "Recordar más tarde": arena sólida, borde y reloj cacao (acción general). -->
    <style name="Widget.VitalLog.Button.Alarm.Snooze">
        <item name="backgroundTint">@color/surface_sand</item>
        <item name="strokeColor">@color/brand_primary</item>
        <item name="iconTint">@color/brand_primary</item>
        <item name="icon">@drawable/ic_snooze</item>
    </style>

    <!-- "Borrar": arena sólida con borde e icono rojo oscuro + texto. Excepción documentada: el rojo
         de estado marca la única acción destructiva, siempre con bote de basura y texto. -->
    <style name="Widget.VitalLog.Button.Delete">
        <item name="backgroundTint">@color/surface_sand</item>
        <item name="strokeColor">@color/status_danger</item>
        <item name="iconTint">@color/status_danger</item>
        <item name="icon">@drawable/ic_delete</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- "Sí, borrar" dentro del diálogo: mismo botón de borrado, sobre blanco cálido para que pese
         menos que la opción segura. -->
    <style name="Widget.VitalLog.Button.Delete.Confirm">
        <item name="backgroundTint">@color/background</item>
    </style>

    <!-- Opción de una lista (unidad de la dosis, periodo del historial). La elegida lleva check,
         borde cacao grueso y fondo arena (ChoiceButtonStyle); TalkBack la anuncia como marcada. -->
    <style name="Widget.VitalLog.Button.Choice">
        <item name="android:checkable">true</item>
        <item name="backgroundTint">@color/background</item>
        <item name="strokeColor">@color/outline_strong</item>
        <item name="iconTint">@color/brand_primary</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- ===== Campos de texto ===== -->

    <!-- Campo de texto (solo datos que no son signos vitales: nombre, médico o lugar).
         Blanco puro con borde tinta; al escribir, borde cacao más grueso. -->
    <style name="Widget.VitalLog.TextField" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_text_field</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:padding">@dimen/spacing_medium</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

</resources>
