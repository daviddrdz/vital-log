<?xml version="1.0" encoding="utf-8"?>
<!--
    Paleta "Sobremesa" de VitalLog (docs/DESIGN_DIRECTION.md, CLAUDE.md §3.3).
    Regla: texto e iconos oscuros sobre fondos claros sólidos, contraste ≥ 7:1 (WCAG AAA).
    Ningún color lleva canal alfa. Verificar cada par nuevo con
    .claude/skills/gerontological-ui-auditor/scripts/contrast.py
    Verde, ámbar y rojo son exclusivos de los estados de una lectura: ninguna acción los usa.
-->
<resources>
    <!-- Base: blanco cálido y tinta café casi negra -->
    <color name="background">#FFFFFAF3</color>
    <color name="text_primary">#FF2A1E14</color>
    <color name="text_secondary">#FF4A3B2E</color>
    <color name="outline_strong">#FF2A1E14</color>

    <!-- Superficie arena: botones secundarios, "Volver" y acciones generales -->
    <color name="surface_sand">#FFF3ECE2</color>

    <!-- Marca (cacao): borde e icono de acciones generales sobre arena o fondo.
         La app no usa superficies rellenas de colorPrimary (serían claro sobre oscuro). -->
    <color name="brand_primary">#FF5A3A22</color>
    <color name="brand_primary_container">@color/surface_sand</color>

    <!-- Signos vitales: acento (icono, borde) + contenedor claro (relleno) -->
    <color name="vital_glucose">#FF1E3A8A</color>
    <color name="vital_glucose_container">#FFE2E8FA</color>
    <color name="vital_pressure">#FF6B1E5A</color>
    <color name="vital_pressure_container">#FFF4E4F0</color>

    <!-- Alias temporales: los usan layouts y Java que se actualizan en los Hitos 8–9.
         Se eliminan cuando nadie los referencie. -->
    <color name="surface_neutral">@color/surface_sand</color>
    <color name="action_glucose_fg">@color/vital_glucose</color>
    <color name="action_pressure_fg">@color/vital_pressure</color>
    <color name="action_agenda_fg">@color/brand_primary</color>

    <!-- Estados de lectura (siempre acompañados de texto, nunca solo color) -->
    <color name="status_ok">#FF0B5A23</color>
    <color name="status_warning">#FF6B3E00</color>
    <color name="status_danger">#FF8A0F0F</color>

    <!-- Retroalimentación de guardado: verde claro sólido con borde/check status_ok -->
    <color name="surface_success">#FFE4F3E8</color>
    <!-- Retroalimentación de error: rojo claro sólido con borde/icono status_danger -->
    <color name="surface_error">#FFFDE8E8</color>
</resources>
