<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Tema claro fijo (sin DayNight): texto oscuro sobre fondo claro sólido.
        No existe variante values-night a propósito (CLAUDE.md §3.3).
        Paleta "Sobremesa" (docs/DESIGN_DIRECTION.md): primary = cacao, contenedor = arena,
        superficie = blanco cálido. colorOnPrimary/colorOnError solo existen porque Material los
        exige; la app no pinta superficies rellenas de primary ni de error.
    -->
    <style name="Base.Theme.VitalLog" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/background</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/background</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline_strong</item>
        <item name="colorError">@color/status_danger</item>
        <item name="colorOnError">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- Iconos oscuros en las barras del sistema sobre el fondo claro -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Sin tinte de elevación de Material 3: una superficie del mismo color que colorSurface
             (p. ej. "Sí, borrar" en blanco cálido, dentro del diálogo) puede teñirse de cacao según
             su elevación. La app separa superficies con bordes sólidos, nunca con sombras ni tintes. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="materialButtonStyle">@style/Widget.VitalLog.Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.VitalLog.Dialog</item>
    </style>

    <!-- Diálogos (confirmación de borrado): blanco cálido sólido y radio 20 como el modal de
         alarma (nivel "modal"). El tinte de elevación ya está apagado en el tema base. -->
    <style name="ThemeOverlay.VitalLog.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.VitalLog</item>
        <item name="colorSurface">@color/background</item>
    </style>

    <style name="MaterialAlertDialog.VitalLog" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">@color/background</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VitalLog.Dialog</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <style name="ShapeAppearance.VitalLog.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_alarm</item>
    </style>

    <style name="Theme.VitalLog" parent="Base.Theme.VitalLog" />
</resources>
