<?xml version="1.0" encoding="utf-8"?>
<!--
    Fila de la agenda: tarjeta blanco cálido con borde tinta y radio 16, con nombre, dosis, hora y un
    botón visible "Borrar". El icono del medicamento va en el encabezado de la sección, no en cada
    tarjeta, para dejar todo el ancho al nombre con fuente 2.0× (se parte con guion, nunca se recorta).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_touch"
    android:background="@drawable/bg_outlined"
    android:orientation="vertical"
    android:padding="@dimen/spacing_medium">

    <TextView
        android:id="@+id/txt_medication_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hyphenationFrequency="normal"
        android:textAppearance="@style/TextAppearance.VitalLog.Label"
        tools:text="Metformina" />

    <TextView
        android:id="@+id/txt_medication_dose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_touch"
        android:textAppearance="@style/TextAppearance.VitalLog.Body"
        tools:text="@string/medication_dose_line" />

    <TextView
        android:id="@+id/txt_medication_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_touch"
        android:textAppearance="@style/TextAppearance.VitalLog.Body"
        tools:text="@string/medication_time_line" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_delete_medication"
        style="@style/Widget.VitalLog.Button.Delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:minWidth="@dimen/touch_target"
        android:minHeight="@dimen/touch_target"
        android:text="@string/btn_delete" />
</LinearLayout>
