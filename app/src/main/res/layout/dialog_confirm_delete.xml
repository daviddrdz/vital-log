<?xml version="1.0" encoding="utf-8"?>
<!--
    Confirmación de borrado: pregunta concreta y dos botones grandes apilados. La opción segura
    ("No, conservar") va primero, es la más visible (arena rellena, 26sp) y está separada 24dp de
    "Sí, borrar" (blanco cálido, borde rojo y bote de basura). ScrollView para fuente 2.0×.
    El fondo blanco cálido sólido lo pone el tema del diálogo (ThemeOverlay.VitalLog.Dialog).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/txt_confirm_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:hyphenationFrequency="normal"
            android:textAppearance="@style/TextAppearance.VitalLog.Title"
            tools:targetApi="p"
            tools:text="@string/confirm_delete_medication_question" />

        <TextView
            android:id="@+id/txt_confirm_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:lineSpacingMultiplier="1.25"
            android:textAppearance="@style/TextAppearance.VitalLog.Body"
            tools:text="@string/confirm_delete_medication_detail" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_keep"
            style="@style/Widget.VitalLog.Button.Keep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:minWidth="@dimen/touch_target"
            android:minHeight="@dimen/primary_button_height"
            android:text="@string/btn_confirm_keep" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_delete"
            style="@style/Widget.VitalLog.Button.Delete.Confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:minWidth="@dimen/touch_target"
            android:minHeight="@dimen/primary_button_height"
            android:text="@string/btn_confirm_delete" />
    </LinearLayout>
</ScrollView>
