<?xml version="1.0" encoding="utf-8"?>
<!-- Un permiso por pantalla: plato con pictograma, título, explicación llana y un solo botón
     "Abrir ajustes". Todo alineado al inicio, como el resto de la app. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.permissions.PermissionsGuideActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <include layout="@layout/view_screen_header" />

        <!-- Plato arena con borde cacao, como el del modal de alarma; el icono lo pone Java. -->
        <ImageView
            android:id="@+id/img_permission_pictogram"
            android:layout_width="@dimen/permission_pictogram_size"
            android:layout_height="@dimen/permission_pictogram_size"
            android:layout_marginTop="@dimen/spacing_large"
            android:background="@drawable/bg_plate_brand"
            android:padding="@dimen/permission_pictogram_padding"
            android:contentDescription="@string/permission_notifications_title"
            android:src="@drawable/ic_notifications"
            app:tint="@color/brand_primary" />

        <TextView
            android:id="@+id/txt_permission_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/permission_notifications_title"
            android:textAppearance="@style/TextAppearance.VitalLog.Label" />

        <TextView
            android:id="@+id/txt_permission_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_touch"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/permission_notifications_body"
            android:textAppearance="@style/TextAppearance.VitalLog.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_settings"
            style="@style/Widget.VitalLog.Button.OpenSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:minWidth="@dimen/touch_target"
            android:minHeight="@dimen/primary_button_height"
            android:text="@string/btn_open_settings" />

        <TextView
            android:id="@+id/txt_permission_return_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/permission_return_hint"
            android:textAppearance="@style/TextAppearance.VitalLog.Body" />
    </LinearLayout>
</ScrollView>
