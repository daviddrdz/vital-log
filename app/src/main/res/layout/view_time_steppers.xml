<?xml version="1.0" encoding="utf-8"?>
<!--
    Hora de un medicamento o una cita: control de hora (12 h + "de la mañana"/"de la tarde"…) y
    control de minutos de 5 en 5, con la hora completa escrita debajo. Lo maneja TimeSteppers.
    Se incluye dentro de un LinearLayout vertical.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <com.davidrdz.vitallog.ui.widget.NumericStepperView
        android:id="@+id/stepper_hour"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        app:stepperLabel="@string/stepper_label_hour" />

    <com.davidrdz.vitallog.ui.widget.NumericStepperView
        android:id="@+id/stepper_minute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        app:stepperLabel="@string/stepper_label_minute" />

    <TextView
        android:id="@+id/txt_time_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.VitalLog.Label"
        tools:text="@string/time_summary" />
</merge>
