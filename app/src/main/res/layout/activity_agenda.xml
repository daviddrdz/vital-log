<?xml version="1.0" encoding="utf-8"?>
<!--
    "Mis medicamentos y citas": dos grupos (medicamentos y citas), cada uno con encabezado + icono
    cacao, su lista de tarjetas y su botón de agregar. Entre grupos hay 40dp; dentro, 12dp.
    Las listas son RecyclerView sin scroll propio dentro de un NestedScrollView (pocas filas; todo
    se desplaza junto). El banner de confirmación va al pie, fuera del scroll, para que siempre se vea.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.agenda.AgendaActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <include layout="@layout/view_screen_header" />

            <TextView
                android:id="@+id/txt_agenda_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/body_agenda"
                android:textAppearance="@style/TextAppearance.VitalLog.Body" />

            <!-- Medicamentos: el icono es decorativo (el título ya lo dice) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_medication"
                    app:tint="@color/brand_primary" />

                <TextView
                    android:id="@+id/txt_medications_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_touch"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/agenda_medications_title"
                    android:textAppearance="@style/TextAppearance.VitalLog.Title"
                    tools:targetApi="p" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_medications_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_touch"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/agenda_medications_empty"
                android:textAppearance="@style/TextAppearance.VitalLog.Body" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_medications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_touch"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_medication" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_medication"
                style="@style/Widget.VitalLog.Button.Add"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_touch"
                android:minWidth="@dimen/touch_target"
                android:minHeight="@dimen/primary_button_height"
                android:text="@string/btn_add_medication" />

            <!-- Citas: el icono es decorativo (el título ya lo dice) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_section"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/brand_primary" />

                <TextView
                    android:id="@+id/txt_appointments_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_touch"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/agenda_appointments_title"
                    android:textAppearance="@style/TextAppearance.VitalLog.Title"
                    tools:targetApi="p" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_appointments_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_touch"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/agenda_appointments_empty"
                android:textAppearance="@style/TextAppearance.VitalLog.Body" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_appointments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_touch"
                android:nestedScrollingEnabled="false"
                tools:itemCount="1"
                tools:listitem="@layout/item_appointment" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_appointment"
                style="@style/Widget.VitalLog.Button.Add"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_touch"
                android:minWidth="@dimen/touch_target"
                android:minHeight="@dimen/primary_button_height"
                android:text="@string/btn_add_appointment"
                app:icon="@drawable/ic_calendar" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.davidrdz.vitallog.feedback.FeedbackBannerView
        android:id="@+id/feedback_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/spacing_medium" />
</LinearLayout>
