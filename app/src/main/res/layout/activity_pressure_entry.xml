<?xml version="1.0" encoding="utf-8"?>
<!--
    El banner de confirmación va fuera del ScrollView, al pie, para que siempre se vea al guardar
    aunque el contenido esté desplazado (CLAUDE.md §3.4).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.pressure.PressureEntryActivity">

    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <include layout="@layout/view_screen_header" />

            <TextView
                android:id="@+id/txt_pressure_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/body_pressure_entry"
                android:textAppearance="@style/TextAppearance.VitalLog.Body" />

            <com.davidrdz.vitallog.ui.widget.NumericStepperView
                android:id="@+id/stepper_systolic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                app:stepperLabel="@string/stepper_label_systolic" />

            <com.davidrdz.vitallog.ui.widget.NumericStepperView
                android:id="@+id/stepper_diastolic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                app:stepperLabel="@string/stepper_label_diastolic" />

            <com.davidrdz.vitallog.ui.widget.ReadingStatusView
                android:id="@+id/view_pressure_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_pressure"
                style="@style/Widget.VitalLog.Button.Save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:minWidth="@dimen/touch_target"
                android:minHeight="@dimen/primary_button_height"
                android:text="@string/btn_save_pressure" />
        </LinearLayout>
    </ScrollView>

    <com.davidrdz.vitallog.feedback.FeedbackBannerView
        android:id="@+id/feedback_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/spacing_medium" />
</LinearLayout>
