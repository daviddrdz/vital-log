<?xml version="1.0" encoding="utf-8"?>
<!--
    Formulario de la agenda. El nombre se escribe con teclado (no es un signo vital, CLAUDE.md §3.1);
    los números se eligen con controles +/−. Al guardar vuelve a la agenda, que muestra el banner.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.agenda.AppointmentFormActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <include layout="@layout/view_screen_header" />

        <TextView
            android:id="@+id/txt_form_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/body_appointment_form"
            android:textAppearance="@style/TextAppearance.VitalLog.Body" />

        <TextView
            android:id="@+id/txt_name_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:labelFor="@id/edit_appointment_place"
            android:text="@string/label_appointment_place"
            android:textAppearance="@style/TextAppearance.VitalLog.Label" />

        <EditText
            android:id="@+id/edit_appointment_place"
            style="@style/Widget.VitalLog.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_touch"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:minHeight="@dimen/touch_target" />

        <TextView
            android:id="@+id/txt_name_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_touch"
            android:accessibilityLiveRegion="polite"
            android:text="@string/error_appointment_place_missing"
            android:textAppearance="@style/TextAppearance.VitalLog.Error"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.davidrdz.vitallog.ui.widget.NumericStepperView
            android:id="@+id/stepper_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            app:stepperLabel="@string/stepper_label_days" />

        <TextView
            android:id="@+id/txt_appointment_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.VitalLog.Label"
            tools:text="@string/appointment_date_summary" />

        <include layout="@layout/view_time_steppers" />

        <TextView
            android:id="@+id/txt_time_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_touch"
            android:accessibilityLiveRegion="polite"
            android:text="@string/error_appointment_time_passed"
            android:textAppearance="@style/TextAppearance.VitalLog.Error"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_appointment"
            style="@style/Widget.VitalLog.Button.Save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:minWidth="@dimen/touch_target"
            android:minHeight="@dimen/primary_button_height"
            android:text="@string/btn_save_appointment" />
    </LinearLayout>
</ScrollView>
