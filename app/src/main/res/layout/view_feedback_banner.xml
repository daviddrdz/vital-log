<?xml version="1.0" encoding="utf-8"?>
<!--
    Contenido de FeedbackBannerView (LinearLayout horizontal con fondo claro sólido y borde oscuro).
    El check es decorativo: el mensaje ya dice qué se guardó, así que TalkBack solo lee el texto.
    El mensaje no es región "live": FeedbackBannerView lo anuncia al mostrarse (evita leerlo dos veces).
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="horizontal"
    tools:parentTag="android.widget.LinearLayout">

    <ImageView
        android:id="@+id/img_feedback_icon"
        android:layout_width="@dimen/icon_feedback_size"
        android:layout_height="@dimen/icon_feedback_size"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/status_ok" />

    <TextView
        android:id="@+id/txt_feedback_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.VitalLog.Label"
        tools:text="@string/saved_glucose" />
</merge>
