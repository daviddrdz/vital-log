<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del banner de error: rojo claro sólido con borde rojo oscuro (sin alfa). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_error" />
    <stroke
        android:width="@dimen/stroke_strong"
        android:color="@color/status_danger" />
    <corners android:radius="@dimen/corner_radius" />
</shape>
