<?xml version="1.0" encoding="utf-8"?>
<!--
    Campo de texto (nombre del medicamento, médico o lugar): blanco puro con borde tinta de 3dp.
    Mientras se escribe en él, el borde pasa a cacao de 5dp: se ve dónde está el cursor sin
    depender solo del color (también cambia el grosor).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_field" />
            <stroke
                android:width="@dimen/stroke_selected"
                android:color="@color/brand_primary" />
            <corners android:radius="@dimen/corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_field" />
            <stroke
                android:width="@dimen/stroke_strong"
                android:color="@color/outline_strong" />
            <corners android:radius="@dimen/corner_radius" />
        </shape>
    </item>
</selector>
