<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta: blanco cálido sólido con borde tinta y radio 16 (agenda, historial, estado de la lectura).
     Las tarjetas no se tocan; sus acciones son botones visibles dentro de ellas. -->

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/background" />
    <stroke
        android:width="@dimen/stroke_strong"
        android:color="@color/outline_strong" />
    <corners android:radius="@dimen/corner_radius" />
</shape>
