<?xml version="1.0" encoding="utf-8"?>
<!--
    Respaldo automático (Android 11 y anteriores). La app ya declara allowBackup="false"; además se
    excluye la base de datos para que los datos de salud nunca salgan del dispositivo
    (CLAUDE.md §2 y §6, Privacidad).
-->
<full-backup-content>
    <exclude domain="database" path="vitallog.db" />
    <exclude domain="database" path="vitallog.db-shm" />
    <exclude domain="database" path="vitallog.db-wal" />
</full-backup-content>
