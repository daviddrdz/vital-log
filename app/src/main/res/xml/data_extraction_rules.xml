<?xml version="1.0" encoding="utf-8"?>
<!--
    Respaldo en la nube y transferencia entre dispositivos (Android 12+). Se excluye la base de datos
    en ambos casos para que los datos de salud nunca salgan del dispositivo (CLAUDE.md §6).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="vitallog.db" />
        <exclude domain="database" path="vitallog.db-shm" />
        <exclude domain="database" path="vitallog.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="vitallog.db" />
        <exclude domain="database" path="vitallog.db-shm" />
        <exclude domain="database" path="vitallog.db-wal" />
    </device-transfer>
</data-extraction-rules>
